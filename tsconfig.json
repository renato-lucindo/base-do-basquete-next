{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "vite.foundation.config.ts"
  ],
  "exclude": [
    "src/server/worker.ts",
    "src/access/durable.ts",
    "src/teams/routes.ts",
    "src/games/routes.ts",
    "src/publication/routes.ts",
    "src/regulation/routes.ts",
    "src/regulation/decision-routes.ts",
    "src/boxscore/routes.ts",
    "src/people/routes.ts",
    "src/people/transfer-routes.ts",
    "src/text-import/routes.ts"
  ]
}
