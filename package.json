{
  "name": "base-do-basquete-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts index.html *.json *.ts *.mjs .github docs README.md",
    "format:check": "prettier --check src tests scripts index.html *.json *.ts *.mjs .github docs README.md",
    "secrets": "node scripts/check-secrets.mjs",
    "gate": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run secrets"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "prettier": "3.9.10",
    "@playwright/test": "1.64.1"
  }
}
