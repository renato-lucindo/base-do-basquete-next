{
  "name": "preview",
  "account_id": "16b4a5e0a99a031d28051ebadb4811cc",
  "main": "src/server/public-preview-worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "preview.basedobasquete.com.br", "custom_domain": true },
  ],
  "assets": {
    "directory": "dist-foundation",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true,
  },
  "vars": {
    "APP_ORIGIN": "https://preview.renato-lucindo-jr.workers.dev",
    "APP_ALIAS": "https://preview.basedobasquete.com.br",
    "ADMIN_ORIGIN": "https://admin.renato-lucindo-jr.workers.dev",
    "SUPABASE_URL": "https://nizmasjddyrhmevvfviz.supabase.co",
    "FLEXIBLE_COMPETITION": "false",
  },
  "secrets": { "required": ["SUPABASE_PUBLISHABLE_KEY"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
  },
}
