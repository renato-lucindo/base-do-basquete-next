{
  "name": "base-do-basquete-next-uiux",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist-foundation",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "https://base-do-basquete-next-uiux.renato-lucindo-jr.workers.dev",
    "SUPABASE_URL": "https://nizmasjddyrhmevvfviz.supabase.co"
  },
  "secrets": {
    "required": [
      "SUPABASE_PUBLISHABLE_KEY",
      "SESSION_ENCRYPTION_KEY"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionStore"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "7725531426651",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true
  }
}
